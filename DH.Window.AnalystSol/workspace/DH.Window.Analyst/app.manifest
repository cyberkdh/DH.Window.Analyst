<?xml version="1.0" encoding="utf-8"?>
<!--
This inspector tool queries GetWindowRect/GetClientRect on windows owned by OTHER processes.
Without declaring DPI awareness here, Windows treats this process as DPI-unaware and applies
DPI virtualization to those cross-process rect queries — the returned coordinates come from a
thunk cache that does not reliably refresh, so a target window's rect can appear frozen even
after the window is moved. Per-Monitor V2 awareness makes the queries live.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.2" name="DH.Window.Analyst.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
