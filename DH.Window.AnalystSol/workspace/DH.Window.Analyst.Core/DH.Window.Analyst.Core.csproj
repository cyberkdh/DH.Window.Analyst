<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net46</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DH.Window.Analyst</RootNamespace>
    <AssemblyName>DH.Window.Analyst.Core</AssemblyName>
    <Version>1.0.0.1</Version>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <BaseOutputPath>..\..\output\</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="System.Drawing" />
    <!-- MessageHookMonitorService's message-only receiver window (NativeWindow/CreateParams) needs this -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- lets CI build net46 without the full .NET Framework Developer Pack installed on the runner -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

</Project>
